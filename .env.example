# ====================================================
# ZYKO.AI WEB PLATFORM ENVIRONMENT CONFIGURATION
# ====================================================

# Port for Zeabur / Local (automatically set by Zeabur)
PORT=8080

# Database path (SQLite file stored in persistent volume or local container)
DB_PATH=zyko_web.db

# JWT Secret for session authentication (change to a random string in production)
JWT_SECRET=zyko_production_jwt_secret_change_me_2026

# ----------------------------------------------------
# 1. Google OAuth Authentication (Google Identity Services)
# ----------------------------------------------------
# Get credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ----------------------------------------------------
# 2. Telegram Bot Integration & Auth
# ----------------------------------------------------
# Bot token from @BotFather (used to verify Telegram widget login)
ELEVENLABS_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=ZykoAi_bot

# ----------------------------------------------------
# 3. Stripe Payments (International: Visa, MC, Apple Pay, Google Pay)
# ----------------------------------------------------
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_or_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_your_publishable_key
# Stripe webhook signing secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ----------------------------------------------------
# 4. Platega Payments (Russia & CIS: SBP, Mir, Russian Cards)
# ----------------------------------------------------
# Credentials from https://platega.io dashboard
PLATEGA_MERCHANT_ID=your_platega_merchant_id
PLATEGA_SECRET=your_platega_secret_key
PLATEGA_BASE_URL=https://app.platega.io

# ----------------------------------------------------
# 5. CryptoPay Payments (Crypto: USDT, TON, BTC)
# ----------------------------------------------------
# Token from @CryptoBot or @CryptoPayTestBot
CRYPTO_PAY_TOKEN=your_cryptopay_token

# ----------------------------------------------------
# 6. ElevenLabs API Keys (Multi-Key Pool Rotation)
# ----------------------------------------------------
# Provide comma-separated list of keys for auto-failover and load balancing:
ELEVENLABS_API_KEY=primary_elevenlabs_api_key
ELEVENLABS_API_KEYS=key1,key2,key3,key4,key5,key6,key7

# ----------------------------------------------------
# 7. AI Model API Keys (Generations & Expansions)
# ----------------------------------------------------
# Google Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key

# HuggingFace API key for FLUX.1 Ultra
HUGGINGFACE_API_KEY=your_huggingface_api_key
